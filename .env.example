# ---------------------------------------------------------------------------
# Mindspace backend environment
# Copy this file to `.env` and fill in the values from your Supabase project.
# ---------------------------------------------------------------------------

# Port the Express API listens on.
PORT=4000

# Supabase project URL — Project Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase service role key — Project Settings → API → service_role secret.
# NEVER expose this key to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma separated list of allowed browser origins (CORS).
FRONTEND_URL=http://localhost:3000
